APP_NAME=WedPlanConnect
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Asia/Manila

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL via XAMPP (manuscript stack). Start MySQL in the XAMPP Control Panel before running the app.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wedplanconnect
DB_USERNAME=root
DB_PASSWORD=

# Inactivity logout after 30 minutes; set SESSION_SECURE_COOKIE=true when served over HTTPS.
SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
SESSION_HTTP_ONLY=true
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@fmtweddings.test"
MAIL_FROM_NAME="FMT Weddings & Events"

# WedPlanConnect
# First administrator account, created by `php artisan db:seed`. Change the password after first login.
ADMIN_NAME="FMT Administrator"
ADMIN_EMAIL=admin@fmtweddings.test
ADMIN_PASSWORD=
WEDPLAN_BUSINESS_NAME="FMT Weddings & Events"
WEDPLAN_BUSINESS_ADDRESS="Cebu City, Philippines"
WEDPLAN_CONFLICT_SCOPE=date_venue
CHATBOT_THRESHOLD=0.5
# Optional: enables the Gemini fallback for questions the FAQ knowledge base cannot answer.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
